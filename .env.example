# Twitch app credentials from https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL_LOGIN=ohmtec
# Comma-separated hostnames permitted as Twitch player parents.
# Add the exact production hostname before deploying.
TWITCH_EMBED_PARENT_DOMAINS=localhost,127.0.0.1

# Google Cloud YouTube Data API v3 key and the channel's UC... ID
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Optional comma-separated YouTube video URLs shown when uploads cannot load
YOUTUBE_FALLBACK_VIDEO_URLS=

# Public canonical site URL, used for metadata (include https:// in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
